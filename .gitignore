# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# ── Distribution / packaging ──────────────────────────────────
build/
dist/
*.egg-info/
.eggs/

# ── Testing ───────────────────────────────────────────────────
