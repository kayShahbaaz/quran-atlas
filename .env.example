# Copy this to .env and fill in your values
# cp .env.example .env

# Path to your downloaded Tanzil XML file
# Download from: https://tanzil.net/download/
TANZIL_XML_PATH=./data/quran-simple.xml

# Where to store the SQLite database
DB_PATH=./db/quran.db

# Where to store generated embeddings (numpy .npy files)
EMBEDDINGS_PATH=./embeddings/verse_embeddings.npy

# Dash server settings
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=True
